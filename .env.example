# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR CBT EXAMINATION PLATFORM
# ==============================================================================

# Core Settings
SECRET_KEY=django-insecure-cbt-platform-dev-key-change-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Platform Branding (Configurable)
PLATFORM_NAME="TestForge CBT"
PLATFORM_TAGLINE="Commercial-Grade Online Examination & Assessment Engine"
PLATFORM_SUPPORT_EMAIL="support@testforge.local"

# Database Configuration
# Options: 'sqlite' (zero-setup local dev) or 'postgres' (production / PostgreSQL)
DB_ENGINE=sqlite
DB_NAME=testgen_cbt
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery & Background Tasks
CELERY_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Student private practice: whole minutes. Presets outside these limits are hidden.
PRACTICE_MIN_DURATION_MINUTES=5
PRACTICE_MAX_DURATION_MINUTES=360
PRACTICE_MAX_PDF_PAGES=100
# Optional absolute path outside MEDIA_ROOT and STATIC_ROOT; protect at the web server.
# PRIVATE_PRACTICE_ROOT=/srv/testforge/private-practice

# Local scanned-page OCR: install English/Hindi Tesseract language data.
# Usually auto-detected. On Windows, forward slashes also work in .env files.
TESSERACT_CMD=
# TESSDATA_PREFIX=C:/Program Files/Tesseract-OCR/tessdata

# Historical optional MinerU backend (not offered on new upload forms).
# Its preserved local subprocess needs its OWN virtualenv; configuring it does
# not change the current local PyMuPDF/Tesseract-only upload workflow.
# Historical setup (one time, a SEPARATE venv, NOT the app's venv):
#   python -m venv C:/Users/you/mu            # use a SHORT path on Windows (long-path limit)
#   C:/Users/you/mu/Scripts/pip install "mineru[torch]"
#   # models download automatically on first run (~1 GB, cached locally)
# Then point MINERU_PYTHON at that venv's interpreter:
MINERU_PYTHON=
# MINERU_PYTHON=C:/Users/you/mu/Scripts/python.exe
MINERU_EFFORT=medium            # flash|medium (local torch pipeline; avoids the VLM/llama.cpp component)
MINERU_MODEL_SOURCE=huggingface # huggingface|modelscope|local (where model WEIGHTS are fetched; never the document)
MINERU_MAX_PAGES=60
MINERU_TIMEOUT_SECONDS=7200     # MinerU is slow on CPU (~40s/page); it runs as a background job

# Optional unverified post-submission comparisons (off by default). No model is bundled.
# Set the exact name of an already downloaded LOCAL model from `ollama list`.
# On the Ollama service itself, set OLLAMA_NO_CLOUD=1, restart it, and verify
# /api/status reports cloud.disabled=true. This app never downloads a model.
LOCAL_PRACTICE_AI_ENABLED=False
LOCAL_PRACTICE_AI_MODEL=
# Optional LOCAL vision model (e.g. an already-downloaded Ollama multimodal model)
# used only to compare image / image-first questions after submission. Empty =
# image questions show an honest "no local vision model" state. Images go only to
# the local Ollama instance; the student's chosen answer is never sent.
LOCAL_PRACTICE_AI_VISION_MODEL=
LOCAL_PRACTICE_AI_VISION_MAX_IMAGES=4
LOCAL_PRACTICE_AI_PORT=11434
LOCAL_PRACTICE_AI_TIMEOUT=120
LOCAL_PRACTICE_AI_MAX_QUESTIONS=300

# Razorpay TEST mode ONLY. Never enable test credits on production data.
# Use a disposable sandbox database and private files; live keys are rejected.
ALLOW_TEST_PAYMENT_CREDITS=False
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# The origin used in verification emails. HTTP is allowed only with DEBUG=True;
# use the real public HTTPS origin (no path) for any deployed environment.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Safe local default: prints verification links to the server console; sends no email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@testforge.local
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
# For a dedicated Gmail sender, see docs/commercial-operations.md. Configure
# SMTP host/user/app password in your private environment, not in this file.


# Historical cloud-extraction settings (not offered on new upload forms).
# Historical use required explicit per-upload consent; setting these values
# does not enable the modes on current upload forms.
# Keep credentials only in your private .env / secret manager; never commit them.
# Gemini-only mode does not use Mathpix. Costs depend on the selected model/tokens.
PDF_GEMINI_ENABLED=False
PDF_GEMINI_MODEL=
# Optional reasoning level (minimal/low/medium/high) if the selected model supports it.
PDF_GEMINI_THINKING_LEVEL=
PDF_GEMINI_MAX_OUTPUT_TOKENS=32768
# Optional per-job delay between Gemini requests (seconds; 0 disables it).
# This is not a global limit across users/workers.
PDF_GEMINI_MIN_INTERVAL_SECONDS=0
GEMINI_API_KEY=
# The existing Mathpix + Gemini mode is separately controlled and configured.
PDF_CLOUD_ENABLED=False
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
# Explicit model ID for Mathpix + Gemini; leave both model IDs blank until verified.
GEMINI_MODEL=
# Shared page limit; polling/timeout and generation settings below are for Mathpix + Gemini.
PDF_CLOUD_MAX_PAGES=50
PDF_CLOUD_POLL_SECONDS=3
PDF_CLOUD_TIMEOUT_SECONDS=900
# Optional reasoning level (minimal/low/medium/high) only if the model supports it.
PDF_CLOUD_THINKING_LEVEL=
PDF_CLOUD_MAX_OUTPUT_TOKENS=32768

# Optional answer suggestions (separate from transcription and disabled by default).
# Set an available model ID for your account; the server checks it before use.
# AI_INPUT/OUTPUT prices are optional estimates per million tokens in USD.
AI_ANSWER_ENABLED=False
AI_ANSWER_MODEL=
AI_ANSWER_MIN_CONFIDENCE=0.70
AI_ANSWER_THINKING_LEVEL=
AI_ANSWER_MAX_OUTPUT_TOKENS=32768
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# Reverse-proxy deployments: set specific HTTPS origins and enable only if the
# proxy strips untrusted X-Forwarded-Proto headers.
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_HTTPS=False
