# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR CBT EXAMINATION PLATFORM
# ==============================================================================

# Core Settings
SECRET_KEY=django-insecure-cbt-platform-dev-key-change-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Platform Branding (Configurable)
PLATFORM_NAME="TestForge CBT"
PLATFORM_TAGLINE="Commercial-Grade Online Examination & Assessment Engine"
PLATFORM_SUPPORT_EMAIL="support@testforge.local"

# Database Configuration
# Options: 'sqlite' (zero-setup local dev) or 'postgres' (production / PostgreSQL)
DB_ENGINE=sqlite
DB_NAME=testgen_cbt
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery & Background Tasks
CELERY_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Student private practice: whole minutes. Presets outside these limits are hidden.
PRACTICE_MIN_DURATION_MINUTES=5
PRACTICE_MAX_DURATION_MINUTES=360
PRACTICE_MAX_PDF_PAGES=100
# Optional absolute path outside MEDIA_ROOT and STATIC_ROOT; protect at the web server.
# PRIVATE_PRACTICE_ROOT=/srv/testforge/private-practice

# Tesseract OCR Executable (leave blank or specify path if installed)
TESSERACT_CMD=

# Razorpay test mode ONLY. Configure secrets in the server environment; never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Settings (Console backend for safe local development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@testforge.local


# Optional paid Mathpix + Gemini extraction (requires consent for each upload).
# Keep these only in your private .env / secret manager; never commit real keys.
PDF_CLOUD_ENABLED=False
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
GEMINI_API_KEY=
# Explicit model ID from your Gemini account; leave blank until verified.
GEMINI_MODEL=
PDF_CLOUD_MAX_PAGES=50
PDF_CLOUD_POLL_SECONDS=3
PDF_CLOUD_TIMEOUT_SECONDS=900
# Optional reasoning level (low/medium/high) only if the selected model supports it.
PDF_CLOUD_THINKING_LEVEL=
PDF_CLOUD_MAX_OUTPUT_TOKENS=32768

# Optional answer suggestions (separate from transcription and disabled by default).
# Set an available model ID for your account; the server checks it before use.
# AI_INPUT/OUTPUT prices are optional estimates per million tokens in USD.
AI_ANSWER_ENABLED=False
AI_ANSWER_MODEL=
AI_ANSWER_MIN_CONFIDENCE=0.70
AI_ANSWER_THINKING_LEVEL=
AI_ANSWER_MAX_OUTPUT_TOKENS=32768
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# Reverse-proxy deployments: set specific HTTPS origins and enable only if the
# proxy strips untrusted X-Forwarded-Proto headers.
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_HTTPS=False
